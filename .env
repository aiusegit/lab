NESTJS_PORT=3000
# MASTER_SURREALDB_URL, USER, PASS, NS, DB will be taken from docker-compose for 'up'
# but might be needed here if running NestJS outside Docker Compose for some reason.
# For local Docker Compose, these are set by the docker-compose.yml:
# MASTER_SURREALDB_URL=ws://surrealdb:8000/rpc
# MASTER_SURREALDB_USER=root
# MASTER_SURREALDB_PASS=root
# MASTER_SURREALDB_NS=saas_platform
# MASTER_SURREALDB_DB=tenants_db

JWT_SECRET=your_strong_jwt_secret_here

# For local Docker Compose, BAILEYS_SERVICE_URL is set by the docker-compose.yml
# BAILEYS_SERVICE_URL=http://baileys_microservice:3002/api
BAILEYS_SERVICE_API_KEY=your_strong_shared_api_key_for_baileys_internal

AGUI_PROXY_URL=http://localhost:3001/ # Assuming AGUI Proxy runs locally on 3001 if not dockerized yet
DEFAULT_TENANT_ID_FOR_WHATSAPP_INCOMING=your_default_tenant_business_id # e.g., "tenant1"

# Key for Baileys microservice to use when calling this NestJS instance's webhook
BAILEYS_WEBHOOK_API_KEY=your_strong_shared_api_key_for_baileys_webhook
