# Master SurrealDB Connection Details
MASTER_SURREALDB_URL=ws://localhost:8000/rpc
MASTER_SURREALDB_USER=root
MASTER_SURREALDB_PASS=root
MASTER_SURREALDB_NS=master_ns
MASTER_SURREALDB_DB=global_tenants

# Tenant SurrealDB Connection Details (for provisioning and root access to tenant namespaces)
TENANT_SURREALDB_URL=ws://localhost:8000/rpc
TENANT_SURREALDB_ROOT_USER=root
TENANT_SURREALDB_ROOT_PASS=root
# Note: Tenant-specific NS/DB are determined dynamically

# JWT Configuration
JWT_SECRET=yourHighlySecretKeyForJWT!
# JWT_EXPIRES_IN=1h

# Application Port
PORT=3000

# Optional: Master API Key for tenant creation endpoint (if you implement MasterApiKeyGuard)
# MASTER_API_KEY=yourSecretMasterApiKey
