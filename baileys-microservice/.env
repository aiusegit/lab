BAILEYS_PORT=3002
LOG_LEVEL=info
SESSION_FILE_PATH=./whatsapp_sessions/baileys_auth_state

# For local Docker Compose, NESTJS_WEBHOOK_URL is typically set by the docker-compose.yml
# environment section of the baileys_microservice to use service discovery:
# NESTJS_WEBHOOK_URL=http://nestjs_backend:3000/api/whatsapp/webhook/incoming
# However, if running outside docker-compose or for clarity, it can be set here:
NESTJS_WEBHOOK_URL=http://localhost:3000/api/whatsapp/webhook/incoming # Or http://nestjs_backend:3000/api/whatsapp/webhook/incoming

# This is the API key this Baileys service expects from clients like NestJS
BAILEYS_API_KEY_INTERNAL=your_strong_shared_api_key_for_baileys_internal

# This is the API key this Baileys service will send to the NestJS webhook
NESTJS_WEBHOOK_API_KEY=your_strong_shared_api_key_for_baileys_webhook
