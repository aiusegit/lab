BAILEYS_PORT=3002
LOG_LEVEL=info
SESSION_FILE_PATH=./whatsapp_sessions/baileys_auth_state # Path inside container
NESTJS_WEBHOOK_URL=http://nestjs_backend:3000/api/whatsapp/webhook/incoming # For Docker Compose
# NESTJS_WEBHOOK_URL=https://your-nestjs-railway-app.up.railway.app/api/whatsapp/webhook/incoming # For Cloud Deployed NestJS
BAILEYS_API_KEY_INTERNAL=your_strong_shared_api_key # API Key this service expects (must match BAILEYS_SERVICE_API_KEY in NestJS)
NESTJS_WEBHOOK_API_KEY=another_strong_shared_key # API Key this service sends to NestJS (must match BAILEYS_WEBHOOK_API_KEY in NestJS)
